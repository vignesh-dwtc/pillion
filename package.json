{
  "name": "pillion",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "NODE_EXTRA_CA_CERTS=\"${NODE_EXTRA_CA_CERTS:-$HOME/.netskope-ca.pem}\" expo start -c",
    "android": "expo run:android",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "check:bundle": "node scripts/check-android-bundle.mjs",
    "web:serve": "node scripts/serve-web.mjs",
    "relay": "node scripts/dev-relay.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "e2e": "playwright test --trace off",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "android:compile": "cd android && ./gradlew :app:compileDebugKotlin",
    "android:assemble": "cd android && ./gradlew :app:assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-semi-condensed": "^0.4.1",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/marcellus": "^0.4.1",
    "@expo-google-fonts/marcellus-sc": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@livekit/react-native-webrtc": "150.1.1",
    "@noble/hashes": "^2.4.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.35.9",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "uqr": "^0.1.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "babel-preset-expo": "~58.0.25",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "ws": "^8.23.0"
  }
}
